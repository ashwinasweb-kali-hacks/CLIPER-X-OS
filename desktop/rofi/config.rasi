/* Cliper X OS — Rofi Application Launcher Theme */

* {
    bg:         #0a0a1aee;
    bg-alt:     #1a1a2eff;
    fg:         #e0e0e0ff;
    accent:     #ff6e6eff;
    accent-alt: #e94560ff;
    urgent:     #ff0000ff;
    
    background-color: transparent;
    text-color:       @fg;
    font:             "Hack Nerd Font 12";
}

window {
    width:            40%;
    transparency:     "real";
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    12px;
    padding:          20px;
}

mainbox {
    spacing:  15px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing:          10px;
    padding:          10px 15px;
    background-color: @bg-alt;
    border-radius:    8px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search tools...";
    placeholder-color: #555555;
}

listview {
    lines:    12;
    columns:  1;
    spacing:  5px;
    scrollbar: false;
    fixed-height: true;
}

element {
    padding:       8px 12px;
    spacing:       10px;
    border-radius: 6px;
}

element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @accent;
    text-color:       #0a0a1a;
}

element alternate.normal {
    background-color: transparent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}

message {
    padding:          8px 12px;
    background-color: @bg-alt;
    border-radius:    6px;
}
